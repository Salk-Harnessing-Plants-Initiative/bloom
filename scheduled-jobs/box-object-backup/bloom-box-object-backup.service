[Unit]
Description=Bloom storage → Box object mirror (__ENV_NAME__) — copies MinIO objects to Box under their Storage API paths so they stay browsable.
Documentation=https://github.com/Salk-Harnessing-Plants-Initiative/bloom/blob/staging/_WIKI/SCHEDULEDJOBS/box-object-backup.md
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=bloom-deploy
EnvironmentFile=__ENV_FILE__
ExecStart=/usr/bin/python3 __DEPLOY_DIR__/scheduled-jobs/box-object-backup/backup_objects.py --env __ENV_NAME__
StandardOutput=journal
StandardError=journal

# The seed run walks millions of objects over days. The weekly delta is
# small, but a timeout here would leave a half-mirrored tree, so let it run
# and rely on the ledger for resumability instead.
TimeoutStartSec=infinity

# Hardening (defense-in-depth). The job needs network egress (Box), the
# Docker socket (psql in the db container, rclone on the deploy network),
# and its ledger under /var/lib/bloom-box-object-backup.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/bloom-box-object-backup
ProtectHome=read-only
PrivateTmp=yes
RestrictSUIDSGID=yes
LockPersonality=yes
