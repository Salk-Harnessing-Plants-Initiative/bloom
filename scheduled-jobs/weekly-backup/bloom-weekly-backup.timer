[Unit]
Description=Weekly Postgres backup for Bloom __ENV_NAME__
Documentation=https://github.com/Salk-Harnessing-Plants-Initiative/bloom/blob/staging/_WIKI/SCHEDULEDJOBS/weekly-backup.md

[Timer]
OnCalendar=Sun 02:00
# A host that was down at the scheduled time runs the backup once it is back,
# rather than silently skipping a week.
Persistent=true
# Keeps staging and prod from dumping simultaneously on a shared host.
RandomizedDelaySec=15m
Unit=bloom-weekly-backup-__ENV_NAME__.service

[Install]
WantedBy=timers.target
