# ------------------------
# Bloom Web PROD Dockerfile
# ------------------------

# ---- Builder Stage ----
FROM node:24.22.1-bookworm@sha256:6449e19d8184d84062525b6a7524def03146c2cb04a7f08b076680d0e8e4240a AS builder


ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY
ARG NEXT_PUBLIC_SUPABASE_COOKIE_NAME
ARG NEXT_PUBLIC_MCP_URL

ENV NEXT_PUBLIC_SUPABASE_URL=$NEXT_PUBLIC_SUPABASE_URL
ENV NEXT_PUBLIC_SUPABASE_ANON_KEY=$NEXT_PUBLIC_SUPABASE_ANON_KEY
ENV NEXT_PUBLIC_SUPABASE_COOKIE_NAME=$NEXT_PUBLIC_SUPABASE_COOKIE_NAME
ENV NEXT_PUBLIC_MCP_URL=$NEXT_PUBLIC_MCP_URL

WORKDIR /app

COPY package*.json ./
COPY web/package*.json ./web/
COPY packages/*/package*.json ./packages/

# Install system deps for sharp
RUN apt-get update && \
    apt-get install -y build-essential libcairo2-dev libjpeg-dev libpango1.0-dev libgif-dev librsvg2-dev python3 make g++ && \
    rm -rf /var/lib/apt/lists/*

RUN npm cache clean --force
RUN npm install
COPY web ./web
COPY packages ./packages

# Build shared packages (dist/ is gitignored, must build here)
# --skipLibCheck: root node_modules has d3 types incompatible with these packages
RUN cd /app/packages/bloom-js && npx tsc -p tsconfig.json --skipLibCheck
RUN cd /app/packages/bloom-fs && npx tsc -p tsconfig.json --skipLibCheck

# Build the Next.js app
WORKDIR /app/web
RUN npm run build

# Supabase CLI is a dev-only tool (Makefile gen-types); its bundled per-platform
# Go binaries never run here and keep failing the image's CVE gate.
RUN rm -rf /app/node_modules/supabase /app/node_modules/@supabase/cli-* \
           /app/node_modules/.bin/supabase

# ---- Runner Stage ----
FROM node:24.22.1-alpine@sha256:06d7adf3e0ef61a13f1d28682726366f97a15aa1888c934d3ecec86c33918b53 AS runner

# node:24.22.1-alpine's bundled global npm (11.19.1) vendors brace-expansion@5.0.9 and
# undici@6.28.0 (CVE-2026-102276, CVE-2026-102278, CVE-2026-19534). `npm run start`
# (the CMD below) invokes this global npm at runtime, so pin it forward to a version
# that vendors the fixed copies (confirmed: npm@11.21.1 -> brace-expansion@5.0.12, undici@6.29.0).
RUN npm install -g npm@11.21.1

RUN addgroup -S bloom && adduser -S -G bloom bloom

WORKDIR /app/web
COPY --from=builder --chown=bloom:bloom /app/web/.next ./.next
COPY --from=builder --chown=bloom:bloom /app/web/public ./public
COPY --from=builder --chown=bloom:bloom /app/web/next.config.js ./
COPY --from=builder --chown=bloom:bloom /app/web/package*.json ./
COPY --from=builder --chown=bloom:bloom /app/node_modules /app/node_modules

EXPOSE 3000
ENV NODE_ENV=production

USER bloom
CMD ["npm", "run", "start", "--", "-H", "0.0.0.0"]
