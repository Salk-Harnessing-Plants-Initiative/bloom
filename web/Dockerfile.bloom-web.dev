
# ------------------------
# Bloom Web DEV Dockerfile
# ------------------------
FROM node:20-bookworm

# Set working directory to root of monorepo
WORKDIR /app

COPY package*.json ./
COPY web/package*.json ./web/
COPY packages/*/package*.json ./packages/

ENV NODE_ENV=development
# Supabase credentials injected via docker-compose environment or build args
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY
ENV NEXT_PUBLIC_SUPABASE_URL=${NEXT_PUBLIC_SUPABASE_URL}
ENV NEXT_PUBLIC_SUPABASE_ANON_KEY=${NEXT_PUBLIC_SUPABASE_ANON_KEY}
# SERVICE_ROLE_KEY provided at runtime via docker-compose environment

RUN npm install --workspaces

# Supabase CLI is a host tool (Makefile gen-types / migrate-local); its bundled
# per-platform Go binaries never run in this container.
RUN rm -rf /app/node_modules/supabase /app/node_modules/@supabase/cli-* \
           /app/node_modules/.bin/supabase

COPY web/ ./
COPY packages ./packages

WORKDIR /app/web

EXPOSE 3000
CMD ["npm", "run", "dev"]
