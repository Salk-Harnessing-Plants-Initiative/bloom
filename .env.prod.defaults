# =============================================================================
# Bloom v2 — production deploy-time env config (non-sensitive)
#
# This file is COMMITTED. It contains configuration values only:
# domains, ports, URLs, feature flags, standard identifiers. Nothing
# sensitive — no passwords, no API keys, no cryptographic material.
#
# At deploy time the workflow:
#   1. Copies this file to $PROD_DEPLOY_PATH/.env.prod
#   2. Appends sensitive values from GitHub Secrets (cat >> .env.prod)
#   3. Validates the assembled file has every required key
#   4. Starts `docker compose up`
#
# Sensitive values live in GitHub Secrets under these names:
#   PROD_POSTGRES_PASSWORD, PROD_JWT_SECRET, PROD_JWT_KEYS, PROD_JWT_JWKS,
#   PROD_ANON_KEY, PROD_SERVICE_ROLE_KEY, PROD_DB_ENC_KEY, PROD_MINIO_PASSWORD,
#   PROD_VAULT_ENC_KEY, PROD_SUPAVISOR_ENC_KEY, PROD_SECRET_KEY_BASE,
#   PROD_DASHBOARD_PASSWORD, PROD_BLOOMMCP_API_KEY, PROD_OPENAI_API_KEY,
#   PROD_LANGCHAIN_API_KEY, PROD_BLOOM_AGENT_KEY, PROD_CLOUDFLARE_API_TOKEN
#
# PROD_JWT_KEYS/PROD_JWT_JWKS are the asymmetric pair and are NOT provisioned
# yet. Populate them only once main carries the per-service JWKS wiring, or
# Storage refuses every ES256 token the moment they land (#646).
#
# CI enforces that nothing in this file matches PASSWORD|SECRET|KEY|TOKEN.
# See openspec/changes/refactor-env-config-committed-defaults/ for rationale.
# =============================================================================

# Domains
DOMAIN_MAIN=bloom.salk.edu
DOMAIN_STUDIO=studio.bloom.salk.edu
DOMAIN_MINIO=minio.bloom.salk.edu

# Caddy issues a single multi-SAN cert for bloom.salk.edu + *.bloom.salk.edu.
# The legacy bloom-dev.salk.edu hostname is not served after cutover —
# scanner / graviscan clients reconfigure to bloom.salk.edu beforehand.
CADDY_HTTP_LISTEN_PORT=80
CADDY_HTTPS_LISTEN_PORT=443
CADDY_SITE_ADDRESSES=https://bloom.salk.edu, https://*.bloom.salk.edu

# CLOUDFLARE_API_TOKEN needs to be added to github secrets

# Database
POSTGRES_DB=postgres
POSTGRES_USER=supabase_admin
POSTGRES_PORT=5432
POSTGRES_HOST=db-prod
POSTGRES_HOST_PORT=5432
PGRST_DB_SCHEMAS=public,auth,storage

# Service ports (Docker internal)
KONG_PORT=8000
BLOOM_WEB_PORT=3000
STUDIO_PORT=3000
MINIO_CONSOLE_PORT=9001

# Supavisor pooler
POOLER_TENANT_ID=default
POOLER_DEFAULT_POOL_SIZE=5
POOLER_MAX_CLIENT_CONN=100
POOLER_DB_POOL_SIZE=10

# Studio organization / project labels (display-only, not auth)
STUDIO_DEFAULT_ORGANIZATION=Bloom
STUDIO_DEFAULT_PROJECT=default
# DASHBOARD_USERNAME and MINIO_ROOT_USER live in GitHub Secrets — they pair
# with admin passwords, so treat as credentials rather than config.

SITE_URL=https://bloom.salk.edu
API_EXTERNAL_URL=https://bloom.salk.edu/api
ADDITIONAL_REDIRECT_URLS=https://bloom.salk.edu
NEXT_PUBLIC_SUPABASE_URL=https://bloom.salk.edu/api
NEXT_PUBLIC_APP_URL=https://bloom.salk.edu
SUPABASE_URL=http://kong:8000
# Cross-environment URL-hostname fence (boot-time validateOnBoot +
# /api/config in production mode). Format:
#   <internal_host>=<public_host>[,<internal_host>=<public_host>]*
# See openspec/changes/add-ghcr-image-publishing design.md Decision 13.
SUPABASE_URL_HOSTS_ALLOWED=kong:8000=bloom.salk.edu
SUPABASE_PUBLIC_URL=https://bloom.salk.edu/api
SUPABASE_COOKIE_NAME=sb-bloom-auth-token
STUDIO_SUPABASE_PUBLIC_URL=https://studio.bloom.salk.edu
MINIO_BROWSER_REDIRECT_URL=https://minio.bloom.salk.edu
CORS_ORIGINS=https://bloom.salk.edu
BLOOM_PLOTS_URL=https://bloom.salk.edu/plots

# Internal service URLs
BLOOM_MCP_URL=http://bloommcp:8811/mcp
IMGPROXY_URL=http://imgproxy:5001
IMGPROXY_ENABLE_WEBP_DETECTION=true

# Bloom app paths
BLOOM_PLOTS_DIR=/app/data/PLOTS_DIR

# Auth flags
ENABLE_ANONYMOUS_USERS=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
DISABLE_SIGNUP=false
JWT_EXPIRY=3600

# OAuth 2.1 server — off by deliberate rollout decision, not just a missing
# dependency: the bloom-web consent route ships in the same deploy as this
# file, but PROD_JWT_KEYS/PROD_JWT_JWKS (required once GOTRUE_OAUTH_SERVER_ENABLED=true,
# since a client requesting the `openid` scope needs ES256) are not yet
# provisioned in GitHub Secrets. Flip this only after that's done.
GOTRUE_OAUTH_SERVER_ENABLED=false
GOTRUE_OAUTH_SERVER_AUTHORIZATION_PATH=/oauth/consent
GOTRUE_OAUTH_SERVER_ALLOW_DYNAMIC_REGISTRATION=false
GOTRUE_OAUTH_SERVER_AUTHORIZATION_TTL=600s
# Supabase's public signing keys, used to verify OAuth tokens once this
# environment signs ES256. Read only when the two vars below are set.
BLOOMMCP_PUBLIC_URL=https://bloom.salk.edu/bloommcp
BLOOMMCP_OAUTH_AUTHORIZATION_SERVER=https://bloom.salk.edu/api/auth/v1
BLOOMMCP_OAUTH_JWKS_URI=https://bloom.salk.edu/api/auth/v1/.well-known/jwks.json

# SMTP relay via Salk's neoemex1 MTA (TLS 1.2 on port 25, IP-whitelisted; no auth)
SMTP_HOST=neoemex1.salk.edu
SMTP_PORT=25
SMTP_ADMIN_EMAIL=noreply@bloom.salk.edu
SMTP_SENDER_NAME=Bloom
SMTP_MAX_FREQUENCY=60s

# LangChain / LangSmith
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=bloom-prod

# Local LLM (vLLM) — Spark host on Salk LAN.
LOCAL_LLM_URL=http://10.1.38.28:8000/v1
LOCAL_LLM_MODEL=Qwen/Qwen3.5-9B

# Browser-facing langchain agent endpoint. Caddy routes /langchain/* on
# this host to langchain-agent:5002; the URL is baked into the bloom-web
# JS bundle at build time (NEXT_PUBLIC_*) so the browser can hit it.
NEXT_PUBLIC_MCP_URL=https://bloom.salk.edu
